{
  "name": "sungeki",
  "version": "0.1.0",
  "private": true, "license": "MIT",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.22.3",
    "npm": "10.9.8"
  },
  "workspaces": [
    "apps/desktop",
    "packages/api-client",
    "packages/vrm",
    "workers/vrm"
  ],
  "scripts": {
    "dev": "npm run dev -w @sungeki/desktop",
    "build": "npm run build -w @sungeki/desktop",
    "check": "npm run check -w @sungeki/desktop",
    "test": "npm run test -w @sungeki/desktop",
    "check:negative-types": "node scripts/check-negative-types.mjs",
    "check:structure": "node scripts/check-source-size.mjs && node scripts/check-dependencies.mjs",
    "desktop:dev": "npm run prepare:host && node scripts/desktop-dev.mjs",
    "desktop:build": "npm run prepare:host && npm run tauri -w @sungeki/desktop -- build --no-bundle",
    "desktop:dist": "node scripts/prepare-host.mjs --dist && npm run tauri -w @sungeki/desktop -- build --no-bundle -- --profile dist --locked",
    "check:mcp": "node scripts/check-mcp.mjs",
    "desktop:bundle": "npm run desktop:build && node scripts/bundle-local.mjs",
    "desktop:dist:bundle": "node scripts/prepare-host.mjs --dist && node scripts/bundle-local.mjs --dist",
    "generate:api": "cargo run --release --locked -p sungeki-protocol --bin generate-api",
    "check:api": "cargo run --release --locked -p sungeki-protocol --bin generate-api -- --check",
    "prepare:host": "node scripts/prepare-host.mjs",
    "test:host": "python3 -m unittest discover -s tests/host -v",
    "check:vrm": "npm run check -w @sungeki/vrm && npm run check -w @sungeki/vrm-worker",
    "build:vrm": "npm run build -w @sungeki/vrm-worker",
    "setup:vrm": "node --experimental-strip-types workers/vrm/src/setup.ts",
    "probe:vrm": "npm run build:vrm && node --experimental-strip-types workers/vrm/src/main.ts",
    "test:vrm": "node --experimental-strip-types --test tests/vrm/*.test.ts",
    "test:vrm-lifecycle": "npm run build:vrm && node scripts/check-vrm-lifecycle.mjs",
    "setup:image": "node scripts/image-runtime.mjs setup",
    "probe:image": "node scripts/image-runtime.mjs probe",
    "test:setup": "node --test scripts/image-runtime.test.mjs scripts/lib/ssd-runtime.test.mjs scripts/lib/desktop-environment.test.mjs scripts/sbv2/profile.test.mjs scripts/sbv2/catalog.test.mjs scripts/qwen/setup.test.mjs",
    "measure:build": "node scripts/measure-build.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "precheck": "npm run check:toolchain",
    "pretest": "npm run check:toolchain",
    "prebuild": "npm run check:toolchain",
    "prebuild:vrm": "npm run check:toolchain",
    "precheck:vrm": "npm run check:toolchain",
    "predesktop:build": "npm run check:toolchain",
    "predesktop:dist": "npm run check:toolchain",
    "predesktop:dev": "npm run check:toolchain",
    "predesktop:dist:bundle": "npm run check:toolchain",
    "pretest:vrm": "npm run check:toolchain",
    "pretest:vrm-lifecycle": "npm run check:toolchain",
    "presetup:vrm": "npm run check:toolchain",
    "check:examples": "npm run check:toolchain && tsc -p examples/mcp/tsconfig.json && node --experimental-strip-types --test examples/mcp/*.test.ts"
  }
}
